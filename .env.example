APP_NAME="Kingshot Alliance"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=UTC
GIFT_CODES_MODERATION=false
GIFT_CODES_APPROVED_SOURCE_INGESTION=false
GIFT_CODES_NOTIFICATION_FANOUT=false
GIFT_CODES_REDEMPTION_WORKSPACE=false
GIFT_CODES_REDEMPTION_INTELLIGENCE=false
GIFT_CODES_ALLIANCE_COVERAGE=false
GIFT_CODES_CONTRIBUTOR_REPUTATION=false
GIFT_CODES_SOURCE_WEBHOOK_INGESTION=false
GIFT_CODES_SOURCE_WEBHOOK_SECRET=
GIFT_CODES_X_BEARER_TOKEN=
GIFT_CODES_DISCORD_BOT_TOKEN=
GIFT_CODES_YOUTUBE_API_KEY=
GIFT_CODES_REDDIT_CLIENT_ID=
GIFT_CODES_REDDIT_CLIENT_SECRET=
GIFT_CODES_REDDIT_USER_AGENT=
GIFT_CODES_FACEBOOK_ACCESS_TOKEN=
GIFT_CODES_INSTAGRAM_ACCESS_TOKEN=
GIFT_CODES_META_GRAPH_API_VERSION=v26.0
GIFT_CODES_INDEPENDENT_EVIDENCE_THRESHOLD=2
GIFT_CODES_MAX_REDEMPTION_ATTEMPTS=6
GIFT_CODES_FANOUT_BATCH_SIZE=200
GIFT_CODES_CATALOG_PAGE_SIZE=25
GIFT_CODES_WORKSPACE_PAGE_SIZE=25
GIFT_CODES_MAX_SESSION_CODES=100
GIFT_CODES_MAX_SESSION_GOVERNORS=50
GIFT_CODES_MAX_SESSION_ITEMS=500
GIFT_CODES_INTELLIGENCE_MIN_SAMPLES=5
GIFT_CODES_INTELLIGENCE_MIN_ACCOUNTS=5
GIFT_CODES_INTELLIGENCE_WINDOW_HOURS=168
GIFT_CODES_REMINDER_HORIZON_DAYS=30
GIFT_CODES_SOURCE_WEBHOOK_CLOCK_SKEW_SECONDS=300
GIFT_CODES_INGESTION_BATCH_SIZE=100
GIFT_CODES_INGESTION_TIMEOUT_SECONDS=10
GIFT_CODES_TRANSITION_CAMPAIGNS_PER_RUN=10
GIFT_CODES_MAX_GOVERNORS_PER_ACCOUNT=50
APP_VERSION=dev
RELEASE_SHA=local

LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=kingshot
DB_USERNAME=kingshot
DB_PASSWORD=kingshot-local-only

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_SCHEME=tcp
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

FILESYSTEM_DISK=local
CONTENT_MEDIA_DISK=local
CONTENT_MEDIA_MAX_KB=8192
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ca-central-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@example.test
MAIL_FROM_NAME="${APP_NAME}"

REGISTRATION_MODE=open
INVITATION_TTL_HOURS=72

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

PULSE_ENABLED=false
HORIZON_PREFIX=kingshot_horizon:
HORIZON_LOCAL_MAX_PROCESSES=3
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8080,127.0.0.1,127.0.0.1:8080

SECURITY_CSP_ENABLED=false
TRUSTED_PROXIES=
ALLOW_TRUST_ALL_PROXIES=false
ALLOW_INSECURE_LOOPBACK_STAGING=false

LAUNCH_MINIMUM_PLATFORM_ADMINISTRATORS=2
LAUNCH_OUTBOX_GRACE_MINUTES=15
LAUNCH_MAXIMUM_OVERDUE_OUTBOX=0
LAUNCH_MAXIMUM_FAILED_JOBS=0
LAUNCH_WEBHOOK_FAILURE_WINDOW_MINUTES=60
LAUNCH_MAXIMUM_RECENT_WEBHOOK_FAILURES=25
