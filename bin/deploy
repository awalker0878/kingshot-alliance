#!/usr/bin/env sh
set -eu

image="${1:-}"

if [ -z "$image" ]; then
  echo "Usage: bin/deploy registry/image@sha256:<64-hex-digest>" >&2
  exit 64
fi

case "$image" in
  *@sha256:*) ;;
  *)
    echo "Deployment requires an immutable image digest, not a mutable tag: $image" >&2
    exit 65
    ;;
esac

digest="${image##*@sha256:}"
if ! printf '%s' "$digest" | grep -Eq '^[a-f0-9]{64}$'; then
  echo "Invalid sha256 image digest: $image" >&2
  exit 65
fi

compose_file="${COMPOSE_FILE:-docker-compose.staging.yml}"
env_file="${ENV_FILE:-deploy/staging.env}"
port="${STAGING_HTTP_PORT:-8080}"
url="${STAGING_URL:-http://127.0.0.1:$port}"

if [ ! -f "$compose_file" ]; then
  echo "Compose file not found: $compose_file" >&2
  exit 66
fi

if [ ! -f "$env_file" ]; then
  echo "Environment file not found: $env_file" >&2
  echo "Create it from deploy/staging.env.example and supply real secrets." >&2
  exit 66
fi

env_mode="$(stat -c '%a' "$env_file" 2>/dev/null || stat -f '%Lp' "$env_file" 2>/dev/null || true)"
case "$env_mode" in
  400|600) ;;
  *)
    echo "Environment file must be owner-readable only (mode 400 or 600): $env_file" >&2
    exit 77
    ;;
esac

command -v docker >/dev/null 2>&1 || {
  echo "Docker is required." >&2
  exit 69
}
command -v curl >/dev/null 2>&1 || {
  echo "curl is required for deployment health checks." >&2
  exit 69
}

export APP_IMAGE="$image"
export STAGING_ENV_FILE="$env_file"
export STAGING_HTTP_PORT="$port"

compose() {
  docker compose --env-file "$env_file" -f "$compose_file" "$@"
}

runtime_services_are_running() {
  running_services="$(compose ps --status running --services)"

  for service in app web worker scheduler; do
    if ! printf '%s\n' "$running_services" | grep -qx "$service"; then
      return 1
    fi
  done

  return 0
}

runtime_services_use_requested_image() {
  expected_image_id="$(docker image inspect --format '{{.Id}}' "$image" 2>/dev/null || true)"
  [ -n "$expected_image_id" ] || return 1

  for service in app web worker scheduler; do
    container_id="$(compose ps -q "$service")"
    [ -n "$container_id" ] || return 1

    actual_image_id="$(docker inspect --format '{{.Image}}' "$container_id" 2>/dev/null || true)"
    [ "$actual_image_id" = "$expected_image_id" ] || return 1
  done

  return 0
}

compose config --quiet

had_running_app=false
if compose ps --status running --services 2>/dev/null | grep -qx app; then
  had_running_app=true
fi

compose pull app web worker scheduler release
compose up -d postgres redis

if [ "$had_running_app" = true ] && [ "${SKIP_BACKUP:-NO}" != "YES" ]; then
  COMPOSE_FILE="$compose_file" \
  ENV_FILE="$env_file" \
  APP_IMAGE="$image" \
  STAGING_ENV_FILE="$env_file" \
  ./bin/backup
fi

if [ "${SKIP_MIGRATIONS:-NO}" != "YES" ]; then
  compose --profile release run --rm release
fi

compose up -d --remove-orphans app web worker scheduler

attempt=1
max_attempts="${HEALTHCHECK_ATTEMPTS:-30}"
while [ "$attempt" -le "$max_attempts" ]; do
  if runtime_services_are_running \
    && runtime_services_use_requested_image \
    && curl --fail --silent --show-error "$url/up" >/dev/null \
    && curl --fail --silent --show-error "$url/health/ready" >/dev/null; then
    echo "Deployment healthy: $image"
    echo "Endpoint: $url"
    exit 0
  fi

  sleep 2
  attempt=$((attempt + 1))
done

echo "Deployment failed health or image verification after $max_attempts attempts." >&2
compose ps >&2
expected_image_id="$(docker image inspect --format '{{.Id}}' "$image" 2>/dev/null || printf 'unknown')"
printf 'Expected image ID: %s\n' "$expected_image_id" >&2
for service in app web worker scheduler; do
  container_id="$(compose ps -q "$service" 2>/dev/null || true)"
  if [ -n "$container_id" ]; then
    actual_image_ref="$(docker inspect --format '{{.Config.Image}}' "$container_id" 2>/dev/null || printf 'unknown')"
    actual_image_id="$(docker inspect --format '{{.Image}}' "$container_id" 2>/dev/null || printf 'unknown')"
    printf '%s image: %s (%s)\n' "$service" "$actual_image_ref" "$actual_image_id" >&2
  fi
done
compose logs --tail=100 app web worker scheduler >&2 || true
exit 70
