#!/usr/bin/env sh
set -eu

backup_file="${1:-}"
compose_file="${COMPOSE_FILE:-docker-compose.yml}"
env_file="${ENV_FILE:-}"

if [ -z "$backup_file" ] || [ ! -f "$backup_file" ]; then
  echo "Usage: bin/restore path/to/database-<timestamp>.sql.gz" >&2
  exit 64
fi

compose() {
  if [ -n "$env_file" ]; then
    docker compose --env-file "$env_file" -f "$compose_file" "$@"
  else
    docker compose -f "$compose_file" "$@"
  fi
}

command -v docker >/dev/null 2>&1 || {
  echo "Docker is required." >&2
  exit 69
}
command -v gzip >/dev/null 2>&1 || {
  echo "gzip is required." >&2
  exit 69
}
command -v sha256sum >/dev/null 2>&1 || {
  echo "sha256sum is required." >&2
  exit 69
}

backup_dir="$(dirname "$backup_file")"
backup_name="$(basename "$backup_file")"
case "$backup_name" in
  database-*.sql.gz)
    timestamp="${backup_name#database-}"
    timestamp="${timestamp%.sql.gz}"
    manifest_file="$backup_dir/manifest-$timestamp.txt"
    ;;
  *)
    manifest_file=""
    ;;
esac

if [ -z "$manifest_file" ] || [ ! -f "$manifest_file" ]; then
  if [ "${ALLOW_UNVERIFIED_RESTORE:-NO}" != "YES" ]; then
    echo "Matching backup manifest not found. Set ALLOW_UNVERIFIED_RESTORE=YES only after an explicit integrity review." >&2
    exit 66
  fi
else
  expected_checksum="$(sed -n 's/^database_sha256=//p' "$manifest_file" | head -n 1)"
  actual_checksum="$(sha256sum "$backup_file" | awk '{print $1}')"

  if [ -z "$expected_checksum" ] || [ "$actual_checksum" != "$expected_checksum" ]; then
    echo "Backup checksum verification failed." >&2
    exit 65
  fi

  echo "Backup checksum verified: $actual_checksum"
fi

echo "This operation replaces the selected database."
echo "Set CONFIRM_RESTORE=YES to continue."

if [ "${CONFIRM_RESTORE:-NO}" != "YES" ]; then
  exit 65
fi

web_service="${WEB_SERVICE:-}"
if [ -z "$web_service" ]; then
  case "$compose_file" in
    *staging*) web_service=web ;;
    *) web_service=nginx ;;
  esac
fi

compose stop app "$web_service" worker scheduler
compose exec -T postgres sh -lc \
  'dropdb --if-exists --username="$POSTGRES_USER" "$POSTGRES_DB" && createdb --username="$POSTGRES_USER" "$POSTGRES_DB"'

gzip -dc "$backup_file" | compose exec -T postgres sh -lc \
  'psql --username="$POSTGRES_USER" --dbname="$POSTGRES_DB" --set ON_ERROR_STOP=on'

compose run --rm app php artisan migrate --force
compose start app "$web_service" worker scheduler

echo "Restore completed and application services restarted."
