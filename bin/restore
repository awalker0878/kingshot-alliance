#!/usr/bin/env sh
set -eu
umask 077

backup_file="${1:-}"
compose_file="${COMPOSE_FILE:-docker-compose.yml}"
env_file="${ENV_FILE:-}"

if [ -z "$backup_file" ] || [ ! -f "$backup_file" ]; then
  echo "Usage: bin/restore path/to/database-<timestamp>.sql.gz" >&2
  exit 64
fi

compose() {
  if [ -n "$env_file" ]; then
    docker compose --env-file "$env_file" -f "$compose_file" "$@"
  else
    docker compose -f "$compose_file" "$@"
  fi
}

command -v docker >/dev/null 2>&1 || {
  echo "Docker is required." >&2
  exit 69
}
command -v gzip >/dev/null 2>&1 || {
  echo "gzip is required." >&2
  exit 69
}
command -v sha256sum >/dev/null 2>&1 || {
  echo "sha256sum is required." >&2
  exit 69
}
command -v mktemp >/dev/null 2>&1 || {
  echo "mktemp is required." >&2
  exit 69
}

gzip -t "$backup_file"

backup_dir="$(dirname "$backup_file")"
backup_name="$(basename "$backup_file")"
case "$backup_name" in
  database-*.sql.gz)
    timestamp="${backup_name#database-}"
    timestamp="${timestamp%.sql.gz}"
    manifest_file="$backup_dir/manifest-$timestamp.txt"
    ;;
  *)
    manifest_file=""
    ;;
esac

if [ -z "$manifest_file" ] || [ ! -f "$manifest_file" ]; then
  if [ "${ALLOW_UNVERIFIED_RESTORE:-NO}" != "YES" ]; then
    echo "Matching backup manifest not found. Set ALLOW_UNVERIFIED_RESTORE=YES only after an explicit integrity review." >&2
    exit 66
  fi
else
  manifest_database_count="$(grep -c '^database_file=' "$manifest_file" || true)"
  manifest_checksum_count="$(grep -c '^database_sha256=' "$manifest_file" || true)"
  manifest_database="$(sed -n 's/^database_file=//p' "$manifest_file" | head -n 1)"
  expected_checksum="$(sed -n 's/^database_sha256=//p' "$manifest_file" | head -n 1)"
  actual_checksum="$(sha256sum "$backup_file" | awk '{print $1}')"

  if [ "$manifest_database_count" != "1" ] \
    || [ "$manifest_checksum_count" != "1" ] \
    || [ "$manifest_database" != "$backup_name" ] \
    || ! printf '%s' "$expected_checksum" | grep -Eq '^[a-f0-9]{64}$' \
    || [ "$actual_checksum" != "$expected_checksum" ]; then
    echo "Backup manifest or checksum verification failed." >&2
    exit 65
  fi

  echo "Backup manifest and checksum verified: $actual_checksum"
fi

if ! compose ps --status running --services | grep -qx postgres; then
  echo "The PostgreSQL service is not running." >&2
  exit 69
fi

if ! compose exec -T postgres sh -lc \
  'pg_isready --username="$POSTGRES_USER" --dbname="$POSTGRES_DB"' >/dev/null 2>&1; then
  echo "PostgreSQL is not ready for restore." >&2
  exit 69
fi

echo "This operation replaces the selected database."
echo "Set CONFIRM_RESTORE=YES to continue."

if [ "${CONFIRM_RESTORE:-NO}" != "YES" ]; then
  exit 65
fi

web_service="${WEB_SERVICE:-}"
if [ -z "$web_service" ]; then
  case "$compose_file" in
    *staging*) web_service=web ;;
    *) web_service=nginx ;;
  esac
fi

plain_file="$(mktemp "${TMPDIR:-/tmp}/kingshot-restore.XXXXXX")"
cleanup() {
  rm -f "$plain_file"
}
trap cleanup EXIT
trap 'exit 1' HUP INT TERM

gzip -dc "$backup_file" > "$plain_file"
test -s "$plain_file"

compose stop app "$web_service" worker scheduler
compose exec -T postgres sh -lc \
  'dropdb --force --if-exists --username="$POSTGRES_USER" "$POSTGRES_DB" && createdb --username="$POSTGRES_USER" "$POSTGRES_DB"'

compose exec -T postgres sh -lc \
  'psql --username="$POSTGRES_USER" --dbname="$POSTGRES_DB" --set ON_ERROR_STOP=on' \
  < "$plain_file"

compose run --rm app php artisan migrate --force
compose start app "$web_service" worker scheduler

echo "Restore import completed and application services restarted. Verify readiness before declaring recovery successful."
