includes:
    - phpstan-baseline.neon
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app
        - routes
    level: 8
    phpVersion: 80500
    treatPhpDocTypesAsCertain: false
    # The baseline is generated from main to isolate legacy debt from CV4 work.
    # CV4 is allowed to fix a baselined main error without producing an
    # unmatched-ignore failure; any new error that is not in that baseline
    # continues to fail static analysis normally.
    reportUnmatchedIgnoredErrors: false
