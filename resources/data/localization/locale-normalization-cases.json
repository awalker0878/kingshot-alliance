    {
      "header": "fr-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-cd;q=1,xx-ZZ;q=0.5",
      "expected": "en",
      "description": "Overlong language tag with unsupported backup"
    },
    {
      "header": ";;, , ;,fr-CA;q=0.9",
      "expected": "fr",
      "description": "Valid French tag after garbage separators should still be considered if parser retains it"
