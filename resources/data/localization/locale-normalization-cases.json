  ],
  "priority": [
    {
      "candidates": ["../fr", "pt_BR", "de-CH"],
      "expected": "pt-BR"
    },
    {
      "candidates": ["zh-Hant-HK", "fr-CA"],
      "expected": "zh-TW"
    },
    {
      "candidates": ["bogus", "fr-CA"],
      "expected": "fr"
    },
    {
      "candidates": ["zh-cnX", null, "es-419"],
      "expected": "es"
    },
    {
      "candidates": [null, "", "zz"],
      "expected": "en"
    },
    {
      "candidates": [],
      "expected": "en"
    },
    {
      "candidates": ["\u00a0fr\u00a0", "pt_BR"],
      "expected": "pt-BR"
    },
    {
      "candidates": ["\ufefffr\ufeff", "pt_BR"],
      "expected": "pt-BR"
    },
    {
      "candidates": ["\ffr\f", "pt_BR"],
      "expected": "pt-BR"
    }
  ],
  "headers": [
    {
      "header": "fr-CA;q=0.8,en-US;q=0.5",
      "cookie": null,
      "expected": "fr"
    },
    {
      "header": "pt-BR;q=1,fr-CA;q=0.8",
      "cookie": null,
      "expected": "pt-BR"
    },
    {
      "header": "en-US;q=0.2,fr-CA;q=0.9",
      "cookie": null,
      "expected": "fr"
    },
    {
      "header": "zh-Hant-HK;q=0.9,en-US;q=0.1",
      "cookie": null,
      "expected": "zh-TW"
    },
    {
      "header": "zz-ZZ;q=1,es-419;q=0.7",
      "cookie": "../invalid",
      "expected": "es"
    },
    {
      "header": "*,zz-ZZ;q=0.9,xx;q=0.8",
      "cookie": "fr-CA;q=0.8",
      "expected": "en"
    },
    {
      "header": "*,zz-ZZ;q=0.9,xx;q=0.8",
      "cookie": null,
      "expected": "en"
    },
    {
      "header": "fr-CA;q=0.8,en-US;q=0.5",
      "cookie": "de",
      "expected": "de"
    },
    {
      "cookie": "\u00a0ar\u00a0",
      "header": "fr-CA;q=0.8,en;q=0.2",
      "expected": "fr"
    },
    {
      "cookie": "\ufeffar\ufeff",
      "header": "fr-CA;q=0.8,en;q=0.2",
      "expected": "fr"
    },
    {
      "cookie": "\far\f",
      "header": "fr-CA;q=0.8,en;q=0.2",
      "expected": "fr"
    }
  ],
  "malformedHeaders": [
    {
      "header": ";;, , ;,zz-ZZ;q=0.9",
      "expected": "en",
      "description": "Stray separators and unsupported language"
    },
    {
      "header": "fr-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-cd;q=1,xx-ZZ;q=0.5",
      "expected": "en",
      "description": "Overlong language tag with unsupported backup"
    },
    {
      "header": ";;, , ;,fr-CA;q=0.9",
      "expected": "fr",
      "description": "Valid French candidate after garbage separators must be retained"
    },
    {
      "header": "zh-hantX;q=1,xx-ZZ;q=0.5",
      "expected": "en",
      "description": "Spoofed Chinese script-like range cannot fall back to zh-CN"
    },
    {
      "header": "pt-brX;q=1,xx-ZZ;q=0.5",
      "expected": "en",
      "description": "Spoofed Portuguese region-like range cannot fall back to pt-BR"
    },
    {
      "header": "zh-hantX;q=1,fr-CA;q=0.4",
      "expected": "fr",
      "description": "Malformed highest-weight range is discarded; valid lower-weight French survives"
    },
    {
      "header": "pt-brX;q=1,es-419;q=0.4",
      "expected": "es",
      "description": "Malformed Portuguese range is discarded; valid Spanish survives"
    },
    {
      "header": "fr-CA-;q=1,pt-BR;q=0.3",
      "expected": "pt-BR",
      "description": "Malformed trailing separator does not eclipse a later valid candidate"
    },
    {
      "header": "fr-CA;q=0.2,de-DE;q=0.9",
      "expected": "de",
      "description": "Valid q ordering is preserved across supported languages"
    },
    {
      "header": "fr-CA;q=0.7,de-DE;q=0.7",
      "expected": "fr",
      "description": "Equal q values retain original header order"
    },
    {
      "header": "fr-CA;q=0,es-MX;q=0.6",
      "expected": "es",
      "description": "q=0 range is not an acceptable fallback"
    },
    {
      "header": "fr-CA;q=1.5,de-DE;q=0.4",
      "expected": "de",
      "description": "Invalid q parameter discarded; later valid candidate retained"
    },
    {
      "header": "fr_CA;q=1,de-DE;q=0.5",
      "expected": "de",
      "description": "Underscore is invalid in a raw HTTP language range"
    },
    {
      "header": "fr-CA;q=1;foo=bar,ja-JP;q=0.3",
      "expected": "ja",
      "description": "Additional unexpected header parameter invalidates that range"
    },
    {
      "header": "*,zz-ZZ;q=0.9,fr-CA;q=0.8",
      "expected": "fr",
      "description": "Wildcard/unsupported entries do not hide later supported range"
    },
    {
      "header": "zh-Hant-HK-x-private;q=0.8,fr-CA;q=0.1",
      "expected": "zh-TW",
      "description": "Valid script/region/private-use ranges still map to the supported locale"
    },
    {
      "header": "fr-CA;q=0.4,de-DE;q=0.1",
      "expected": "fr",
      "description": "Valid weighted fallback without malformed input"
    },
    {
      "header": "fr-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-ab-cd;q=1,de-DE;q=0.4",
      "expected": "de",
      "description": "Overlong high-quality French range must not hide a valid lower-quality German fallback"
    },
    {
      "description": "Raw U+00A0 is not HTTP optional whitespace",
      "header": "\u00a0ar\u00a0,de-DE;q=0.5",
      "expected": "de"
    },
    {
      "description": "Raw U+FEFF is not HTTP optional whitespace",
      "header": "\ufeffar\ufeff,de-DE;q=0.5",
      "expected": "de"
    },
    {
      "description": "Raw U+000C is not HTTP optional whitespace",
      "header": "\far\f,de-DE;q=0.5",
      "expected": "de"
    }
  ],
  "realisticBrowserHeaders": [
    {
      "header": "en-US,en;q=0.9",
      "navigatorLanguages": ["en-US", "en"],
      "expected": "en"
    },
    {
      "header": "pt-BR,pt;q=0.9,en;q=0.8",
      "navigatorLanguages": ["pt-BR", "pt", "en"],
      "expected": "pt-BR"
    },
    {
      "header": "zh-Hant-TW,zh;q=0.9,en;q=0.8",
      "navigatorLanguages": ["zh-Hant-TW", "zh", "en"],
      "expected": "zh-TW"
    },
    {
      "header": "ar-IQ,ar;q=0.9,en;q=0.8",
      "navigatorLanguages": ["ar-IQ", "ar", "en"],
      "expected": "ar"
    },
    {
      "header": "fr-CA,fr;q=0.9,en;q=0.8",
      "navigatorLanguages": ["fr-CA", "fr", "en"],
      "expected": "fr"
    },
    {
      "header": "es-MX,es;q=0.9,en;q=0.8",
      "navigatorLanguages": ["es-MX", "es", "en"],
      "expected": "es"
    },
    {
      "header": "zh-Hans-CN,zh;q=0.9,en;q=0.8",
      "navigatorLanguages": ["zh-Hans-CN", "zh", "en"],
      "expected": "zh-CN"
    },
    {
      "header": "id-ID,id;q=0.9,en;q=0.8",
      "navigatorLanguages": ["id-ID", "id", "en"],
      "expected": "id"
    }
  ]
}
