      "header": "fr-CA;q=0.8,en-US;q=0.5",
      "cookie": null,
      "expected": "fr"
    },
    {
      "header": "pt-BR;q=1,fr-CA;q=0.8",
      "cookie": null,
      "expected": "pt-BR"
