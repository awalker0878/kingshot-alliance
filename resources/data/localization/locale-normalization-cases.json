      "candidates": ["../fr", "pt_BR", "de-CH"],
      "expected": "pt-BR"
    },
    {
      "candidates": ["zh-Hant-HK", "fr-CA"],
      "expected": "zh-TW"
    },
    {
      "candidates": ["bogus", "fr-CA"],
      "expected": "fr"
    },
    {
      "candidates": ["zh-cnX", null, "es-419"],
