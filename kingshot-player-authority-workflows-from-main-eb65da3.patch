+    templateForm.template_id = contextTemplates.value[0]?.id ?? '';
+    templateForm.clearErrors();
+  },
+  { immediate: true },
+);
+
+watch(
+  () => form.event_type_id,
+  (id) => applyDefaults(typeOptions.value.find((type) => type.id === id)),
+);
+
+function submit(): void {
+  form.post('/events');
+}
+
+function scheduleTemplate(): void {
