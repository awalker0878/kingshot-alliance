+
+    public function test_reconfirm_after_decline_rechecks_group_capacity(): void
+    {
+        $owner = User::factory()->create();
+        $other = User::factory()->create();
+        $kingdom = Kingdom::query()->create(['number' => 8405, 'status' => 'active']);
