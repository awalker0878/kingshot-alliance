+            foreach ($ids as $optionId) {
+                EventPollVote::query()->create([
+                    'poll_id' => $locked->id,
+                    'option_id' => $optionId,
+                    'player_id' => $player->id,
+                    'cast_by_player_id' => $player->id,
+                    'cast_at' => now(),
+                ]);
+            }
+
+            $target = $this->targets->forEvent($event);
+            $alliance = $target instanceof Alliance ? $target : null;
+            $metadata = [
