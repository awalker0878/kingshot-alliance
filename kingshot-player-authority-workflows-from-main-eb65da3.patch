+
+        $authorization = $this->app->make(EventAuthorization::class);
+        self::assertTrue($authorization->allows(
+            $adminPlayer,
+            EventScope::Kingdom,
+            $firstKingdom,
+            PermissionKey::EventKingdomCreate,
